# This project is Bring-Your-Own-Key (BYOK).
# The deployed Worker stores NO secrets — visitors paste their own
# Bright Data API token in the UI and it is forwarded per request.
#
# You only need a token if you want to run the raw API examples in
# scripts/ or test the pipeline yourself from the command line.
#
# Get a free token: https://brightdata.com  ->  Settings -> API keys
BRIGHT_DATA_API_TOKEN=your-bright-data-token-here

# Dataset IDs (public, not secret) for the two AI Search scrapers:
CHATGPT_DATASET_ID=gd_m7aof0k82r803d5bjm
PERPLEXITY_DATASET_ID=gd_m7dhdot1vw9a7gc1n
